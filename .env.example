# Real account secrets for tools/provision-from-env.py.
# Copy this file to .env and fill it in. .env is gitignored - never commit real secrets.
# Any of GOD_PASSWORD / MAIN_ACCOUNT / MAIN_PASSWORD left blank is generated by the tool
# (a random 7-digit account number, a strong 16-character password) and written back here.

# The God (admin) account. Default 9 - the seed God account.
GOD_ACCOUNT=9
GOD_PASSWORD=change-me-or-leave-blank-to-generate

# The real player account.
MAIN_ACCOUNT=1234567
MAIN_PASSWORD=change-me-or-leave-blank-to-generate

# Optional: a level 1 Rookgaard character created on the main account (leave blank for none).
MAIN_CHARACTER=
# Optional: the main account's e-mail.
MAIN_EMAIL=you@example.com
